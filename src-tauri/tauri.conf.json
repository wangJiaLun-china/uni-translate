{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uni-translate",
  "version": "0.1.0",
  "identifier": "com.wangjialun.uni-translate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "uni-translate",
        "width": 820,
        "height": 600,
        "minWidth": 520,
        "minHeight": 420,
        "center": true
      },
      {
        "label": "popup",
        "title": "uni-translate",
        "width": 420,
        "height": 320,
        "minWidth": 300,
        "minHeight": 180,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "AI translator for OpenAI-compatible APIs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
